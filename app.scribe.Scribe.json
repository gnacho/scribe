{
    "app-id": "app.scribe.Scribe",
    "runtime": "org.gnome.Platform",
    "runtime-version": "46",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "scribe",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=xdg-documents",
        "--filesystem=xdg-download"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/scribe/cargo"
        }
    },
    "modules": [
        {
            "name": "scribe",
            "buildsystem": "simple",
            "build-commands": [
                "cargo --offline fetch --manifest-path Cargo.toml",
                "cargo --offline build --release",
                "install -Dm755 target/release/scribe /app/bin/scribe",
                "install -Dm644 data/app.scribe.Scribe.desktop /app/share/applications/app.scribe.Scribe.desktop",
                "install -Dm644 data/app.scribe.Scribe.gschema.xml /app/share/glib-2.0/schemas/app.scribe.Scribe.gschema.xml",
                "install -Dm644 data/app.scribe.Scribe.metainfo.xml /app/share/metainfo/app.scribe.Scribe.metainfo.xml",
                "glib-compile-schemas /app/share/glib-2.0/schemas"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                },
                {
                    "type": "file",
                    "path": "cargo-sources.json"
                }
            ]
        }
    ]
}
