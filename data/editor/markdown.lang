<?xml version="1.0" encoding="UTF-8"?>
<language id="markdown" name="Markdown" version="2.0" _section="Markup">
  <metadata>
    <property name="mimetypes">text/markdown;text/x-markdown</property>
    <property name="globs">*.md;*.markdown;*.mkd</property>
  </metadata>

  <styles>
    <style id="header" name="Header" map-to="def:heading"/>
    <style id="header-marker" name="Header Marker" map-to="def:heading"/>
    <style id="bold" name="Bold" map-to="def:strong-emphasis"/>
    <style id="italic" name="Italic" map-to="def:emphasis"/>
    <style id="code" name="Code" map-to="def:code"/>
    <style id="code-block" name="Code Block" map-to="def:code"/>
    <style id="link" name="Link" map-to="def:underlined"/>
    <style id="link-url" name="Link URL" map-to="def:underlined"/>
    <style id="blockquote" name="Blockquote" map-to="def:comment"/>
    <style id="list-marker" name="List Marker" map-to="def:operator"/>
    <style id="hr" name="Horizontal Rule" map-to="def:operator"/>
    <style id="strikethrough" name="Strikethrough" map-to="def:comment"/>
  </styles>

  <definitions>
    <context id="markdown">
      <include>
        <context id="header6" style-ref="header">
          <match>^######\s.*$</match>
        </context>
        <context id="header5" style-ref="header">
          <match>^#####\s.*$</match>
        </context>
        <context id="header4" style-ref="header">
          <match>^####\s.*$</match>
        </context>
        <context id="header3" style-ref="header">
          <match>^###\s.*$</match>
        </context>
        <context id="header2" style-ref="header">
          <match>^##\s.*$</match>
        </context>
        <context id="header1" style-ref="header">
          <match>^#\s.*$</match>
        </context>

        <context id="code-block" style-ref="code-block">
          <start>^```</start>
          <end>^```</end>
        </context>

        <context id="code-inline" style-ref="code">
          <match>`[^`]+`</match>
        </context>

        <context id="bold" style-ref="bold">
          <match>\*\*[^\*]+\*\*</match>
        </context>

        <context id="italic" style-ref="italic">
          <match>\*[^\*]+\*</match>
        </context>

        <context id="strikethrough" style-ref="strikethrough">
          <match>~~[^~]+~~</match>
        </context>

        <context id="link" style-ref="link">
          <match>\[[^\]]+\]\([^\)]+\)</match>
        </context>

        <context id="blockquote" style-ref="blockquote">
          <match>^&gt;\s.*$</match>
        </context>

        <context id="list-marker" style-ref="list-marker">
          <match>^(\s*)([-*+]|\d+\.)\s</match>
        </context>

        <context id="hr" style-ref="hr">
          <match>^(---|\*\*\*|___)\s*$</match>
        </context>
      </include>
    </context>
  </definitions>
</language>