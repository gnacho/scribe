<?xml version="1.0" encoding="UTF-8"?>
<!-- Iconos de la app empaquetados como recurso (issue #111): el binario
     suelto (cargo build, copia manual) no instala datos en ningun tema de
     iconos, y el tema de la app podria no tenerlos; con el recurso los
     simbolicos propios se resuelven siempre. Los ficheros siguen
     instalandose en hicolor para el icono de escritorio y la tienda. -->
<gresources>
  <gresource prefix="/io/github/gnacho/Scribe/icons">
    <file alias="io.github.gnacho.Scribe.svg">hicolor/scalable/apps/io.github.gnacho.Scribe.svg</file>
    <file alias="io.github.gnacho.Scribe-preview-on-symbolic.svg">hicolor/scalable/actions/io.github.gnacho.Scribe-preview-on-symbolic.svg</file>
    <file alias="io.github.gnacho.Scribe-preview-off-symbolic.svg">hicolor/scalable/actions/io.github.gnacho.Scribe-preview-off-symbolic.svg</file>
  </gresource>
</gresources>
